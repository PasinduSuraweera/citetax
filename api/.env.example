# ---------------------------------------------------------------------------
# Citetax API — copy this file to `.env` and fill in the three keys below.
# `.env` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# === 1. DATABASE — Supabase (required) =====================================
# Supabase dashboard → Project Settings → Database → Connection string → URI
# Use the **Session pooler** URI (port 5432), and change the scheme to
# postgresql+psycopg:// so SQLAlchemy uses psycopg 3.
#
#   postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
DATABASE_URL=

# === 2. LLM — Groq (required for prose explanations) =======================
# Free key from https://console.groq.com/keys
# Without it the API still works: you get verified figures and citations with
# no prose, which is the documented degradation in spec §13.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# === 3. EMBEDDINGS — Google (only needed from Phase 7, retrieval) ==========
# Free key from https://aistudio.google.com/apikey
# Not required for computations, citations, deadlines or the UI.
# Set EMBEDDING_BACKEND=none to disable dense retrieval entirely.
EMBEDDING_BACKEND=vertex
GOOGLE_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

# === Behaviour =============================================================
CORS_ORIGINS=http://localhost:3000
MAX_FREE_TEXT_TO_LLM=600
